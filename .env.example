# All inference is local. Download weights once before offline use.
DATA_DIR=./data
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_THREADS=4
# Set to 1 after downloading the ASR model; forbids implicit downloads.
ASR_LOCAL_ONLY=0
MAX_AUDIO_SECONDS=600
MAX_UPLOAD_MB=50
MAX_PENDING_JOBS=10
CHUNK_CHARS=800

TRANSLATION_BACKEND=ollama
TRANSLATION_BASE_URL=http://127.0.0.1:11434
TRANSLATION_MODEL=qwen3:4b
REFINER_BACKEND=ollama
REFINER_BASE_URL=http://127.0.0.1:11434
REFINER_MODEL=qwen3:4b
# text for general models; codex_patch for a locally served Codex-web checkpoint.
REFINER_PROTOCOL=text
REFINER_ENABLED=1
MODEL_TIMEOUT_SECONDS=600
# Force CPU on Ollama; use -1 to permit GPU offload.
OLLAMA_NUM_GPU=0
OLLAMA_NUM_CTX=4096
# Optional local OpenAI-compatible servers use BACKEND=compatible and /v1 URLs.
TRANSLATION_API_KEY=
REFINER_API_KEY=
# Remote endpoints require explicit opt-in; defaults reject non-loopback hosts.
ALLOW_REMOTE_MODELS=0

